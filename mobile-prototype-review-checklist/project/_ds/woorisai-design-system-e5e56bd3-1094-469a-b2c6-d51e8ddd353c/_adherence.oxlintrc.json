{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/icons/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/product/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard|NanumSquareRound|Pretendard Variable))/i]",
        "message": "Font not provided by the design system. Available: Pretendard, NanumSquareRound, Pretendard Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessScopeOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|title|description|disabled|key|ref|className|style|children)$/]",
        "message": "<AccessScopeOption> doesn't accept that prop. Declared props: value, title, description, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|name|text1|src|alt|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: className, style, size, name, text1, src, alt, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:24|32|40|48)$/]",
        "message": "<Avatar> size must be one of '24' | '32' | '40' | '48'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|children|tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, style, label, children, tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|info|success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavigation'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|items|value|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNavigation> doesn't accept that prop. Declared props: className, style, items, value, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavigationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|icon|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<BottomNavigationItem> doesn't accept that prop. Declared props: className, style, label, icon, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|title|text1|children|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: className, style, title, text1, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|children|style2|size|state|icon|iconPosition|loading|disabled|fullWidth|type|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: className, style, label, children, style2, size, state, icon, iconPosition, loading, disabled, fullWidth, type, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='style2'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost|neutral-ghost|danger)$/]",
        "message": "<Button> style2 must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'neutral-ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|hover|active|focus|disabled|loading)$/]",
        "message": "<Button> state must be one of 'default' | 'hover' | 'active' | 'focus' | 'disabled' | 'loading'."
      },
      {
